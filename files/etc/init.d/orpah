#!/bin/sh /etc/rc.common
# ORPAH Router 守护进程（procd）
#
# 本脚本刻意做得极薄：只读 `enabled` 决定要不要起进程，配置路径整份交给 daemon
# （daemon 自己解析 UCI —— 字段名因此只有一处，见 orpahd/config.py 里的取舍说明）。
#
# 改完 /etc/config/orpah 不用手动重启：service_triggers 的 reload trigger 加上
# `procd_set_param file` 会让 uci/LuCI 提交后自动 reload。

START=95
STOP=10
USE_PROCD=1

PYTHON=/usr/bin/python3
DAEMON=/usr/lib/orpah/router_daemon.py
CONFIG=/etc/config/orpah
STATUS_FILE=/var/run/orpah/status.json

start_service() {
	config_load orpah
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	mkdir -p "$(dirname "$STATUS_FILE")"

	procd_open_instance orpah
	procd_set_param command "$PYTHON" -u "$DAEMON" \
		--config "$CONFIG" --status-file "$STATUS_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONFIG"
	procd_close_instance
}

stop_service() {
	rm -f "$STATUS_FILE"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger orpah
}
